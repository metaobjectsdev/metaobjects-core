#!/bin/bash
#
# MetaObjects Pre-Push Hook
# Validates cross-language type compatibility before pushing
#
# Install: cp scripts/hooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
#

set -e

echo ""
echo "🔍 Running cross-language compatibility checks..."
echo ""

# Run compatibility validation test
cd "$(git rev-parse --show-toplevel)/metadata"
mvn test -Dtest=CrossLanguageTypeCompatibilityTest -q

if [ $? -eq 0 ]; then
    echo ""
    echo "✅ All compatibility checks passed!"
    echo "✅ Safe to push!"
    echo ""
    exit 0
else
    echo ""
    echo "❌ Compatibility checks failed!"
    echo "❌ Please fix issues before pushing."
    echo ""
    echo "To see detailed errors, run:"
    echo "  cd metadata && mvn test -Dtest=CrossLanguageTypeCompatibilityTest"
    echo ""
    exit 1
fi
